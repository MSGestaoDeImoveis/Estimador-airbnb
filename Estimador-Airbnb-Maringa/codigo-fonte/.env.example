# Copie este arquivo para ".env" (na mesma pasta) e preencha com os dados
# do seu projeto Supabase (Project Settings > API).
#
# NUNCA coloque a "service_role" / Secret Key aqui — apenas a URL do projeto
# e a chave pública (anon / publishable key), que são seguras para uso no navegador.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_ANON_PUBLICA_AQUI
